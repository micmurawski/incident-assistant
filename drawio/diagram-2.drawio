        <mxCell id="3B4_3ruLwvEKuvf9DDW0-23" value="Plan" style="html=1;verticalLabelPosition=bottom;align=center;labelBackgroundColor=#ffffff;verticalAlign=top;strokeWidth=2;strokeColor=#0080F0;shadow=0;dashed=0;shape=mxgraph.ios7.icons.document;fillColor=none;" parent="1" vertex="1">
