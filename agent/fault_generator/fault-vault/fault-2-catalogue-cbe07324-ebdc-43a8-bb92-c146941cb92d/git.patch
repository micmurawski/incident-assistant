index 0b31d13..cf4c3a0 100644
--- a/catalogue/server.js
+++ b/catalogue/server.js
@@ -67,7 +67,11 @@ app.get('/health', (req, res) => {
 app.get('/products', (req, res) => {
     if(mongoConnected) {
         collection.find({}).toArray().then((products) => {
-            res.json(products);
+            // Introduce an artificial delay for performance regression
+            const delay = process.env.PRODUCT_LIST_DELAY || 2000; // Default to 2 seconds
+            setTimeout(() => {
+                res.json(products);
+            }, delay);
         }).catch((e) => {
             req.log.error('ERROR', e);
             res.status(500).send(e);
