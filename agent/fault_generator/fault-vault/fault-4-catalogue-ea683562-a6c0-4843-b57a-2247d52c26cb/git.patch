 var redisHost = process.env.REDIS_HOST || 'redis'
 var catalogueHost = process.env.CATALOGUE_HOST || 'catalogue'
@@ -359,6 +360,10 @@ function calcTax(total) {
 
 function getProduct(sku) {
     return new Promise((resolve, reject) => {
+        if(productCache[sku]) {
+            resolve(productCache[sku]);
+            return;
+        }
         request('http://' + catalogueHost + ':8080/product/' + sku, (err, res, body) => {
             if(err) {
                 reject(err);
@@ -367,7 +372,9 @@ function getProduct(sku) {
             } else {
                 // return object - body is a string
                 // TODO - catch parse error
-                resolve(JSON.parse(body));
+                var productData = JSON.parse(body);
+                productCache[sku] = productData;
+                resolve(productData);
             }
         });
     });
@@ -404,4 +411,3 @@ const port = process.env.CART_SERVER_PORT || '8080';
 app.listen(port, () => {
     logger.info('Started on port', port);
 });
