diff --git a/cart/server.js b/cart/server.js
index 9140821..cb5c035 100644
--- a/cart/server.js
+++ b/cart/server.js
@@ -25,6 +25,7 @@ const counter = new promClient.Counter({
 
 
 var redisConnected = false;
