From b85db008457c63fcd1f86daccde841699bb8c4bd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Mon, 16 Mar 2026 20:40:57 +0100
Subject: [PATCH] fault:
 fault-1-mongo-chaos_pod_kill-66ea165114424623a04b454c9c4368df

---
 catalogue/server.js          | 2 +-
 k8s/manifests/catalogue.yaml | 2 ++
 k8s/manifests/mongodb.yaml   | 1 +
 k8s/manifests/user.yaml      | 2 ++
 user/server.js               | 2 +-
 5 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/catalogue/server.js b/catalogue/server.js
index 8d59498..0f4fe70 100644
--- a/catalogue/server.js
+++ b/catalogue/server.js
@@ -151,7 +151,7 @@ function mongoLoop() {
         logger.info('MongoDB connected');
     }).catch((e) => {
         logger.error('ERROR', e);
-        setTimeout(mongoLoop, 2000);
+        setTimeout(mongoLoop, process.env.MONGO_RETRY_DELAY || 60000);
     });
 }
 
diff --git a/k8s/manifests/catalogue.yaml b/k8s/manifests/catalogue.yaml
index f7c7f6e..777cfbe 100644
--- a/k8s/manifests/catalogue.yaml
+++ b/k8s/manifests/catalogue.yaml
@@ -24,6 +24,8 @@ spec:
             valueFrom:
               fieldRef:
                 fieldPath: status.hostIP
+          - name: MONGO_RETRY_DELAY
+            value: "60000"
         ports:
         - containerPort: 8080
         resources:
diff --git a/k8s/manifests/mongodb.yaml b/k8s/manifests/mongodb.yaml
index 2ca98c3..132b826 100644
--- a/k8s/manifests/mongodb.yaml
+++ b/k8s/manifests/mongodb.yaml
@@ -13,6 +13,7 @@ spec:
   template:
     metadata:
       labels:
+        app: mongo
         service: mongodb
     spec:
       containers:
diff --git a/k8s/manifests/user.yaml b/k8s/manifests/user.yaml
index 6614fa0..b41ffd6 100644
--- a/k8s/manifests/user.yaml
+++ b/k8s/manifests/user.yaml
@@ -25,6 +25,8 @@ spec:
             valueFrom:
               fieldRef:
                 fieldPath: status.hostIP
+          - name: MONGO_RETRY_DELAY
+            value: "60000"
         ports:
         - containerPort: 8080
         resources:
diff --git a/user/server.js b/user/server.js
index f7b488e..cf3c82e 100644
--- a/user/server.js
+++ b/user/server.js
@@ -267,7 +267,7 @@ function mongoLoop() {
         logger.info('MongoDB connected');
     }).catch((e) => {
         logger.error('ERROR', e);
-        setTimeout(mongoLoop, 2000);
+        setTimeout(mongoLoop, process.env.MONGO_RETRY_DELAY || 60000);
     });
 }
 
