+        org.apache.hc.client5.http.config.RequestConfig requestConfig = 
+            org.apache.hc.client5.http.config.RequestConfig.custom()
+                .setConnectTimeout(60, java.util.concurrent.TimeUnit.SECONDS)
+                .setConnectionRequestTimeout(60, java.util.concurrent.TimeUnit.SECONDS)
+                .setResponseTimeout(120, java.util.concurrent.TimeUnit.SECONDS)
+                .build();
+
+        int attempts = 0;
+        int maxAttempts = 5;
+        
+        while (attempts < maxAttempts) {
