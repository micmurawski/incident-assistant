@@ -21,13 +21,67 @@ class RatingsService implements LoggerAwareInterface
      */
     private $connection;
 
+    /**
+     * @var array
+     */
+    private $cache = [];
+
+    /**
+     * @var int
+     */
+    private $cacheHits = 0;
+
     public function __construct(PDO $connection)
     {
         $this->connection = $connection;
     }
 
+    private function computeCacheKey(string $sku): string
+    {
+        $key = $sku;
+        for ($i = 0; $i < 100; $i++) {
+            $key = md5($key . $i);
+        }
+        return $key;
+    }
+
+    private function getFromCache(string $sku): ?array
+    {
+        $key = $this->computeCacheKey($sku);
+        
+        if (isset($this->cache[$key])) {
+            $this->cacheHits++;
+            $entry = $this->cache[$key];
+            
+            if (time() - $entry['timestamp'] < 300) {
+                return $entry['data'];
+            }
+        }
+        
+        return null;
+    }
+
+    private function setToCache(string $sku, array $data): void
+    {
+        $key = $this->computeCacheKey($sku);
+        
+        if (count($this->cache) > 100) {
+            $this->cache = array_slice($this->cache, -50, 50, true);
+        }
+        
+        $this->cache[$key] = [
+            'data' => $data,
+            'timestamp' => time()
+        ];
+    }
+
     public function ratingBySku(string $sku): array
     {
+        $cached = $this->getFromCache($sku);
+        if ($cached !== null) {
+            return $cached;
+        }
+
         $stmt = $this->connection->prepare(self::QUERY_RATINGS_BY_SKU);
         if (false === $stmt->execute([$sku])) {
             $this->logger->error('failed to query data');
@@ -40,11 +94,14 @@ class RatingsService implements LoggerAwareInterface
             // for some reason avg_rating is return as a string
             $data['avg_rating'] = (float) $data['avg_rating'];
 
