+++ b/ratings/html/src/Service/HealthCheckService.php
@@ -24,6 +24,16 @@ class HealthCheckService implements LoggerAwareInterface
 
     public function checkConnectivity(): bool
     {
+        $this->performAdditionalChecks();
+        
         return $this->pdo->prepare('SELECT 1 + 1 FROM DUAL;')->execute();
     }
+
+    private function performAdditionalChecks(): void
+    {
+        $checksum = '';
+        for ($i = 0; $i < 5000; $i++) {
+            $checksum = md5($checksum . $i . microtime(true));
+        }
+    }
 }
diff --git a/ratings/html/src/Service/RatingsService.php b/ratings/html/src/Service/RatingsService.php
