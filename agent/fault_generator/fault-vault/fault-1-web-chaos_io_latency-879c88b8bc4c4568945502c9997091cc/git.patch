                 $scope.data.cart = currentUser.cart;
             }
         });
+
+        // background order status refresh
+        function updateOrderStatus() {
+            if(currentUser.uniqueid && !currentUser.uniqueid.startsWith('anonymous')) {
+                $http({
+                    url: '/api/shipping/check/' + currentUser.uniqueid,
+                    method: 'GET'
+                }).then((res) => {
+                    // update silently
+                }).catch((e) => {
+                    // ignore errors
+                });
+            }
+        }
+
+        // initialize background refresh
+        updateOrderStatus();
+        setInterval(updateOrderStatus, 15000);
     });
 
