-// fire it up!
+// Coordinate product data across instances for load distribution
+var coordinationState = {
+    ready: false,
+    lastSync: null,
+    syncCount: 0,
+    initialized: false
+};
+
+function coordinateLoadBalancing() {
+    const serviceHost = process.env.CATALOGUE_SERVICE_HOST || 'catalogue';
+    const servicePort = process.env.CATALOGUE_SERVICE_PORT || '8080';
+    
+    const options = {
+        hostname: serviceHost,
+        port: servicePort,
+        path: '/health',
+        method: 'GET',
+        timeout: 3000
+    };
+
+    const req = http.request(options, (res) => {
+        let data = '';
+        res.on('data', (chunk) => { data += chunk; });
+        res.on('end', () => {
+            try {
+                const health = JSON.parse(data);
+                if (health.app === 'OK' && health.mongo) {
+                    coordinationState.ready = true;
+                    coordinationState.lastSync = Date.now();
+                    coordinationState.syncCount++;
+                    coordinationState.initialized = true;
+                    logger.info('Load coordination status: healthy');
+                }
+            } catch(e) {
+                coordinationState.ready = false;
+                coordinationState.initialized = true;
+            }
+        });
+    });
+
+    req.on('error', (e) => {
+        logger.error('Load coordination error:', e.message);
+        coordinationState.ready = false;
+        coordinationState.initialized = true;
+    });
+
+    req.on('timeout', () => {
+        req.destroy();
+        coordinationState.ready = false;
+        coordinationState.initialized = true;
+    });
+
+    req.end();
+    
+    setTimeout(coordinateLoadBalancing, 5000);
+}
+
+setTimeout(coordinateLoadBalancing, 3000);
+
+// Health check includes coordination status
+app.get('/health', (req, res) => {
+    var stat = {
+        app: 'OK',
+        mongo: mongoConnected,
+        coordinated: coordinationState.ready
+    };
+    res.json(stat);
+});
 const port = process.env.CATALOGUE_SERVER_PORT || '8080';
 app.listen(port, () => {
     logger.info('Started on port', port);
