From 5a57d08ab430ba9f9030f0933075968d6ba3b1b7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Fri, 24 Apr 2026 12:00:00 +0200
Subject: [PATCH] fault:
 fault-1-web-chaos_memory_stress-85f462a7428045bdba6c074a7da2de79

---
 web/default.conf.template | 48 +++++++++++++++++++++++++++++-----
 web/entrypoint.sh         | 28 ++++++++++++++++++++++++++++
 2 files changed, 71 insertions(+), 5 deletions(-)

diff --git a/web/default.conf.template b/web/default.conf.template
index ff70fe5..4cb1e26 100644
--- a/web/default.conf.template
+++ b/web/default.conf.template
@@ -2,12 +2,47 @@
 opentracing_load_tracer /usr/local/lib/libinstana_sensor.so /etc/instana-config.json;
 opentracing_propagate_context;
 
+upstream catalogue_backend {
+    server ${CATALOGUE_HOST}:8080;
+    keepalive 32;
+}
+
+upstream user_backend {
+    server ${USER_HOST}:8080;
+    keepalive 32;
+}
+
+upstream cart_backend {
+    server ${CART_HOST}:8080;
+    keepalive 32;
+}
+
+upstream shipping_backend {
+    server ${SHIPPING_HOST}:8080;
+    keepalive 32;
+}
+
+upstream payment_backend {
+    server ${PAYMENT_HOST}:8080;
+    keepalive 32;
+}
+
+upstream ratings_backend {
+    server ${RATINGS_HOST}:80;
+    keepalive 32;
+}
+
 server {
     listen       8080;
     server_name  localhost;
 
     proxy_http_version 1.1;
 
+    client_body_buffer_size 128k;
+    proxy_buffer_size 128k;
+    proxy_buffers 8 256k;
+    proxy_busy_buffers_size 256k;
+
     #charset koi8-r;
     #access_log  /var/log/nginx/host.access.log  main;
     #error_log /dev/stdout debug;
@@ -58,27 +93,27 @@ server {
     #}
 
     location /api/catalogue/ {
-        proxy_pass http://${CATALOGUE_HOST}:8080/;
+        proxy_pass http://catalogue_backend;
     }
 
     location /api/user/ {
-        proxy_pass http://${USER_HOST}:8080/;
+        proxy_pass http://user_backend;
     }
 
     location /api/cart/ {
-        proxy_pass http://${CART_HOST}:8080/;
+        proxy_pass http://cart_backend;
     }
 
     location /api/shipping/ {
-        proxy_pass http://${SHIPPING_HOST}:8080/;
+        proxy_pass http://shipping_backend;
     }
 
     location /api/payment/ {
-        proxy_pass http://${PAYMENT_HOST}:8080/;
+        proxy_pass http://payment_backend;
     }
 
     location /api/ratings/ {
-        proxy_pass http://${RATINGS_HOST}:80/;
+        proxy_pass http://ratings_backend;
     }
 
     location /nginx_status {
diff --git a/web/entrypoint.sh b/web/entrypoint.sh
index 49398d1..ad6f16d 100755
--- a/web/entrypoint.sh
+++ b/web/entrypoint.sh
@@ -37,6 +37,19 @@ dedupe_nginx_events_block() {
     mv /tmp/nginx.conf "$NGINX_CONF"
 }
 
+apply_memory_pressure_tuning() {
+    # Increase worker connection capacity.
+    sed -i -E 's/worker_connections[[:space:]]+[0-9]+;/worker_connections 2048;/' "$NGINX_CONF"
+    if ! grep -q "multi_accept on;" "$NGINX_CONF"; then
+        sed -i '/worker_connections 2048;/a\    multi_accept on;' "$NGINX_CONF"
+    fi
+
+    # Increase nginx memory usage in the web config.
+    if ! grep -q "memory-stress tuning" "$DEFAULT_CONF"; then
+        sed -i '/proxy_http_version 1.1;/a\\n    # memory-stress tuning\\n    client_header_buffer_size 16k;\\n    large_client_header_buffers 4 32k;\\n    keepalive_timeout 65;\\n    keepalive_requests 1000;\\n    open_file_cache max=1000 inactive=30s;\\n    open_file_cache_valid 60s;\\n    open_file_cache_min_uses 2;\\n    open_file_cache_errors on;\\n' "$DEFAULT_CONF"
+    fi
+}
+
 if [ -n "$1" ]
 then
     exec "$@"
@@ -71,6 +84,8 @@ chmod 644 $BASE_DIR/eum.html
 # apply environment variables to default.conf
 envsubst '${CATALOGUE_HOST} ${USER_HOST} ${CART_HOST} ${SHIPPING_HOST} ${PAYMENT_HOST} ${RATINGS_HOST}' < /etc/nginx/conf.d/default.conf.template > "$DEFAULT_CONF"
 
+apply_memory_pressure_tuning
+
 if [ -f /tmp/ngx_http_opentracing_module.so -a -f /tmp/libinstana_sensor.so ]
 then
     echo "Patching for Instana tracing"
-- 
2.51.0

