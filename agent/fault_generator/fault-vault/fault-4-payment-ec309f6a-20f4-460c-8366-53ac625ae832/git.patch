Subject: [PATCH] fault: fault-payment-4-ec309f6a-20f4-460c-8366-53ac625ae832

---
 payment/payment.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/payment/payment.py b/payment/payment.py
index ccb821d..8f0a36b 100644
--- a/payment/payment.py
+++ b/payment/payment.py
@@ -25,6 +25,9 @@ CART = os.getenv('CART_HOST', 'cart')
 USER = os.getenv('USER_HOST', 'user')
 PAYMENT_GATEWAY = os.getenv('PAYMENT_GATEWAY', 'https://paypal.com/')
 
+# Cache for payment verification results
+payment_cache = {}
+
 # Prometheus
 PromMetrics = {}
 PromMetrics['SOLD_COUNTER'] = Counter('sold_count', 'Running count of items sold')
@@ -98,6 +101,15 @@ def pay(id):
 
     # Generate order id
     orderid = str(uuid.uuid4())
+
+    # Store verification data for audit trail
+    payment_cache[id] = {
+        'orderid': orderid,
+        'total': cart.get('total', 0),
+        'items': cart.get('items', []),
+        'timestamp': time.time()
+    }
+
     queueOrder({ 'orderid': orderid, 'user': id, 'cart': cart })
 
     # add to order history
