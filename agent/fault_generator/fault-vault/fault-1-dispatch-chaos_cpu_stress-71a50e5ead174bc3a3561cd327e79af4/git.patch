From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Mon, 16 Mar 2026 22:31:53 +0100
Subject: [PATCH] fault:
 fault-1-dispatch-chaos_cpu_stress-71a50e5ead174bc3a3561cd327e79af4

---
 dispatch/main.go            | 9 +++++++++
 k8s/manifests/dispatch.yaml | 4 ++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/dispatch/main.go b/dispatch/main.go
index e0f2748..4a6485f 100644
--- a/dispatch/main.go
+++ b/dispatch/main.go
@@ -161,6 +161,15 @@ func processSale(parentSpan ot.Span) {
 	defer span.Finish()
 	span.SetTag(string(ext.SpanKind), "intermediate")
 	span.LogFields(otlog.String("info", "Order sent for processing"))
+	
+	// Perform order validation checksum
+	var checksum int64
+	orderData := fmt.Sprintf("%d-%s", time.Now().UnixNano(), fmt.Sprintf("%v", parentSpan.Context()))
+	for i := 0; i < 50000; i++ {
+		checksum += int64(len(orderData) * i)
+	}
+	_ = checksum
+	
 	time.Sleep(time.Duration(42+rand.Int63n(42)) * time.Millisecond)
 }
 
diff --git a/k8s/manifests/dispatch.yaml b/k8s/manifests/dispatch.yaml
index 8830c6c..9c33ade 100644
--- a/k8s/manifests/dispatch.yaml
+++ b/k8s/manifests/dispatch.yaml
@@ -27,10 +27,10 @@ spec:
                 fieldPath: status.hostIP
         resources:
           limits:
-            cpu: 200m
+            cpu: 150m
             memory: 100Mi
           requests:
-            cpu: 100m
+            cpu: 80m
             memory: 50Mi
       restartPolicy: Always
   
