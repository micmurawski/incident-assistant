Date: Mon, 16 Mar 2026 20:13:32 +0100
Subject: [PATCH] fault:
 fault-1-payment-chaos_pod_failure-9899cb5fccda41b4b4f881381a67763f

---
 payment/payment.py  | 14 +++++++++++++-
 payment/rabbitmq.py |  5 +++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/payment/payment.py b/payment/payment.py
index ccb821d..1303b0e 100644
--- a/payment/payment.py
+++ b/payment/payment.py
@@ -39,7 +39,14 @@ def exception_handler(err):
 
 @app.route('/health', methods=['GET'])
 def health():
-    return 'OK'
+    # Check RabbitMQ connectivity
+    try:
+        if publisher.is_connected():
+            return 'OK'
+        else:
+            return 'service unavailable', 503
+    except:
+        return 'service unavailable', 503
 
 # Prometheus
 @app.route('/metrics', methods=['GET'])
@@ -134,6 +141,11 @@ def queueOrder(order):
     headers = {}
     publisher.publish(order, headers)
 
+    # Verify order was queued
+    if not publisher.is_connected():
+        app.logger.error('Order may not have been queued')
+        raise Exception('Queue connection failed')
+
 
 def countItems(items):
     count = 0
diff --git a/payment/rabbitmq.py b/payment/rabbitmq.py
index 4456a2f..8af1fa5 100644
--- a/payment/rabbitmq.py
+++ b/payment/rabbitmq.py
@@ -48,3 +48,8 @@ class Publisher:
             self._logger.info('closing queue connection')
             self._conn.close()
 
+    def is_connected(self):
+        if self._conn is None:
+            return False
+        return self._conn.is_open
+
