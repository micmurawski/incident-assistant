+// Session cache helper
+function getSessionCache(key, callback) {
+    redisClient.get('session:' + key, (err, data) => {
+        if (!err && data) {
+            callback(JSON.parse(data));
+        } else {
+            callback(null);
+        }
+    });
+}
+
+function setSessionCache(key, value, ttl) {
+    redisClient.setex('session:' + key, ttl || 1800, JSON.stringify(value), (err, data) => {
+        if (err) {
+            logger.error('Cache set error', err);
+        }
+    });
+}
