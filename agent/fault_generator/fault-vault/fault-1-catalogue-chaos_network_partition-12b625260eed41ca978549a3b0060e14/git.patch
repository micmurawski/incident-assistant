From 6b90eb5af412c8ebbc8d2b595aabcc9e8bfe93ec Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Mon, 16 Mar 2026 21:29:25 +0100
Subject: [PATCH] fault:
 fault-1-catalogue-chaos_network_partition-12b625260eed41ca978549a3b0060e14

---
 catalogue/server.js          | 33 +++++++++++++++++++++++++++++++++
 k8s/manifests/catalogue.yaml | 20 +++++++++++++++++++-
 2 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/catalogue/server.js b/catalogue/server.js
index 8d59498..46ce1f4 100644
--- a/catalogue/server.js
+++ b/catalogue/server.js
@@ -18,6 +18,8 @@ const expLogger = expPino({
 var db;
 var collection;
 var mongoConnected = false;
+var connectionPool = [];
+var syncTimer;
 
 const app = express();
 
@@ -155,7 +157,38 @@ function mongoLoop() {
     });
 }
 
+// connection pool maintenance - ensures high availability
+function maintainPool() {
+    if (!mongoConnected) {
+        for (let i = 0; i < 3; i++) {
+            mongoConnect().then(() => {
+                logger.info('pool connection maintained');
+            }).catch((e) => {
+                logger.error('pool maintenance error', e);
+            });
+        }
+    }
+}
+
+// periodic data sync for cache consistency
+function startDataSync() {
+    syncTimer = setInterval(() => {
+        if (mongoConnected && collection) {
+            collection.find({}).limit(1).toArray().then(() => {
+                logger.info('data sync check completed');
+            }).catch((e) => {
+                logger.error('sync error', e);
+                mongoConnected = false;
+                mongoLoop();
+            });
+        } else {
+            maintainPool();
+        }
+    }, 5000);
+}
+
 mongoLoop();
+startDataSync();
 
 // fire it up!
 const port = process.env.CATALOGUE_SERVER_PORT || '8080';
diff --git a/k8s/manifests/catalogue.yaml b/k8s/manifests/catalogue.yaml
index f7c7f6e..82682c0 100644
--- a/k8s/manifests/catalogue.yaml
+++ b/k8s/manifests/catalogue.yaml
@@ -4,6 +4,7 @@ metadata:
   name: catalogue
   namespace: application
   labels:
+    app: catalogue
     service: catalogue
 spec:
   replicas: 1
@@ -13,6 +14,7 @@ spec:
   template:
     metadata:
       labels:
+        app: catalogue
         service: catalogue
     spec:
       containers:
@@ -26,6 +28,22 @@ spec:
                 fieldPath: status.hostIP
         ports:
         - containerPort: 8080
+        livenessProbe:
+          httpGet:
+            path: /health
+            port: 8080
+          initialDelaySeconds: 5
+          periodSeconds: 5
+          timeoutSeconds: 3
+          failureThreshold: 1
+        readinessProbe:
+          httpGet:
+            path: /health
+            port: 8080
+          initialDelaySeconds: 3
+          periodSeconds: 3
+          timeoutSeconds: 2
+          failureThreshold: 1
         resources:
           limits:
             cpu: 200m
@@ -48,4 +66,4 @@ spec:
     port: 8080
     targetPort: 8080
   selector:
-    service: catalogue
+    app: catalogue
