From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Mon, 16 Mar 2026 21:44:39 +0100
Subject: [PATCH] fault:
 fault-1-user-chaos_network_partition-96e3b091b41d4d8a861998f348fea42f

---
 user/server.js | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/user/server.js b/user/server.js
index f7b488e..7552035 100644
--- a/user/server.js
+++ b/user/server.js
@@ -234,11 +234,26 @@ app.get('/history/:id', (req, res) => {
 
 // connect to Redis
 var redisClient = redis.createClient({
-    host: process.env.REDIS_HOST || 'redis'
+    host: process.env.REDIS_HOST || 'redis',
+    retry_strategy: function(options) {
+        if (options.error && options.error.code === 'ECONNREFUSED') {
+            return new Error('Redis connection refused');
+        }
+        if (options.total_retry_time > 1000 * 60 * 60) {
+            return new Error('Retry time exhausted');
+        }
+        if (options.times_connected > 10) {
+            return undefined;
+        }
+        return Math.min(options.attempt * 50, 2000);
+    },
+    connect_timeout: 500,
+    max_attempts: 20
 });
 
 redisClient.on('error', (e) => {
     logger.error('Redis ERROR', e);
+    redisClient.connect().catch(() => {});
 });
 redisClient.on('ready', (r) => {
     logger.info('Redis READY', r);
@@ -267,7 +282,7 @@ function mongoLoop() {
         logger.info('MongoDB connected');
     }).catch((e) => {
         logger.error('ERROR', e);
-        setTimeout(mongoLoop, 2000);
+        setTimeout(mongoLoop, 100);
     });
 }
 
@@ -278,4 +293,3 @@ const port = process.env.USER_SERVER_PORT || '8080';
 app.listen(port, () => {
     logger.info('Started on port', port);
 });
-
