+            } else {
+                res.json(users);
+            }
         }).catch((e) => {
             req.log.error('ERROR', e);
             res.status(500).send(e);
@@ -105,7 +130,16 @@ app.post('/login', (req, res) => {
             req.log.info('user', user);
             if(user) {
                 if(user.password == req.body.password) {
-                    res.json(user);
+                    ordersCollection.findOne({name: req.body.name}).then((orderData) => {
+                        var userResponse = Object.assign({}, user);
+                        if(orderData && orderData.history) {
+                            userResponse.orderCount = orderData.history.length;
+                        }
+                        res.json(userResponse);
+                    }).catch((e) => {
+                        req.log.error('ERROR', e);
+                        res.json(user);
+                    });
                 } else {
                     res.status(404).send('incorrect password');
                 }
