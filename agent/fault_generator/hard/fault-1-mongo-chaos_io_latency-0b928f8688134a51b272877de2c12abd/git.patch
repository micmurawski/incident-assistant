diff --git a/catalogue/server.js b/catalogue/server.js
index 8d59498..24f223f 100644
--- a/catalogue/server.js
+++ b/catalogue/server.js
@@ -44,7 +44,28 @@ app.get('/health', (req, res) => {
 app.get('/products', (req, res) => {
     if(mongoConnected) {
         collection.find({}).toArray().then((products) => {
-            res.json(products);
+            var enriched = [];
+            var pending = products.length;
+            if(pending === 0) {
+                res.json(products);
+                return;
+            }
+            products.forEach((product) => {
+                collection.findOne({sku: product.sku}).then((detail) => {
+                    enriched.push(detail || product);
+                    pending--;
+                    if(pending === 0) {
+                        res.json(enriched);
+                    }
+                }).catch((e) => {
+                    req.log.error('ERROR', e);
+                    enriched.push(product);
+                    pending--;
+                    if(pending === 0) {
+                        res.json(enriched);
+                    }
+                });
+            });
         }).catch((e) => {
             req.log.error('ERROR', e);
             res.status(500).send(e);
@@ -84,7 +105,28 @@ app.get('/products/:cat', (req, res) => {
     if(mongoConnected) {
         collection.find({ categories: req.params.cat }).sort({ name: 1 }).toArray().then((products) => {
             if(products) {
-                res.json(products);
+                var enriched = [];
+                var pending = products.length;
+                if(pending === 0) {
+                    res.json(products);
+                    return;
+                }
+                products.forEach((product) => {
+                    collection.findOne({sku: product.sku}).then((detail) => {
+                        enriched.push(detail || product);
+                        pending--;
+                        if(pending === 0) {
+                            res.json(enriched);
+                        }
+                    }).catch((e) => {
+                        req.log.error('ERROR', e);
+                        enriched.push(product);
+                        pending--;
+                        if(pending === 0) {
+                            res.json(enriched);
+                        }
+                    });
+                });
             } else {
                 res.status(404).send('No products for ' + req.params.cat);
             }
@@ -117,7 +159,28 @@ app.get('/categories', (req, res) => {
 app.get('/search/:text', (req, res) => {
     if(mongoConnected) {
         collection.find({ '$text': { '$search': req.params.text }}).toArray().then((hits) => {
-            res.json(hits);
+            if(hits.length > 0) {
+                var enriched = [];
+                var pending = hits.length;
+                hits.forEach((hit) => {
+                    collection.findOne({sku: hit.sku}).then((detail) => {
+                        enriched.push(detail || hit);
+                        pending--;
+                        if(pending === 0) {
+                            res.json(enriched);
+                        }
+                    }).catch((e) => {
+                        req.log.error('ERROR', e);
+                        enriched.push(hit);
+                        pending--;
+                        if(pending === 0) {
+                            res.json(enriched);
+                        }
+                    });
+                });
+            } else {
+                res.json(hits);
+            }
         }).catch((e) => {
             req.log.error('ERROR', e);
             res.status(500).send(e);
