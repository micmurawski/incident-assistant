From be609baa71fa4556c63e14d7f5ef6db4297dd0cb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Murawski?= <mmurawski777@gmail.com>
Date: Mon, 16 Mar 2026 21:37:02 +0100
Subject: [PATCH] fault:
 fault-1-web-chaos_memory_stress-85f462a7428045bdba6c074a7da2de79

---
 web/default.conf.template | 48 +++++++++++++++++++++++++++++-----
 web/entrypoint.sh         | 54 ++++++++++++++++++++++++++++++++++-----
 2 files changed, 90 insertions(+), 12 deletions(-)

diff --git a/web/default.conf.template b/web/default.conf.template
index ff70fe5..050f0f8 100644
--- a/web/default.conf.template
+++ b/web/default.conf.template
@@ -2,12 +2,47 @@
 opentracing_load_tracer /usr/local/lib/libinstana_sensor.so /etc/instana-config.json;
 opentracing_propagate_context;
 
+upstream catalogue_backend {
+    server ${CATALOGUE_HOST}:8080;
+    keepalive 32;
+}
+
+upstream user_backend {
+    server ${USER_HOST}:8080;
+    keepalive 32;
+}
+
+upstream cart_backend {
+    server ${CART_HOST}:8080;
+    keepalive 32;
+}
+
+upstream shipping_backend {
+    server ${SHIPPING_HOST}:8080;
+    keepalive 32;
+}
+
+upstream payment_backend {
+    server ${PAYMENT_HOST}:8080;
+    keepalive 32;
+}
+
+upstream ratings_backend {
+    server ${RATINGS_HOST}:80;
+    keepalive 32;
+}
+
 server {
     listen       8080;
     server_name  localhost;
 
     proxy_http_version 1.1;
 
+    client_body_buffer_size 128k;
+    proxy_buffer_size 128k;
+    proxy_buffers 8 256k;
+    proxy_busy_buffers_size 256k;
+
     #charset koi8-r;
     #access_log  /var/log/nginx/host.access.log  main;
     #error_log /dev/stdout debug;
@@ -19,6 +54,7 @@ server {
         ssi    on;
     }
 
+
     location /images/ {
         expires 5s;
         root   /usr/share/nginx/html;
@@ -58,27 +94,27 @@ server {
     #}
 
     location /api/catalogue/ {
-        proxy_pass http://${CATALOGUE_HOST}:8080/;
+        proxy_pass http://catalogue_backend;
     }
 
     location /api/user/ {
-        proxy_pass http://${USER_HOST}:8080/;
+        proxy_pass http://user_backend;
     }
 
     location /api/cart/ {
-        proxy_pass http://${CART_HOST}:8080/;
+        proxy_pass http://cart_backend;
     }
 
     location /api/shipping/ {
-        proxy_pass http://${SHIPPING_HOST}:8080/;
+        proxy_pass http://shipping_backend;
     }
 
     location /api/payment/ {
-        proxy_pass http://${PAYMENT_HOST}:8080/;
+        proxy_pass http://payment_backend;
     }
 
     location /api/ratings/ {
-        proxy_pass http://${RATINGS_HOST}:80/;
+        proxy_pass http://ratings_backend;
     }
 
     location /nginx_status {
diff --git a/web/entrypoint.sh b/web/entrypoint.sh
index a0fc43b..c51fca0 100755
--- a/web/entrypoint.sh
+++ b/web/entrypoint.sh
@@ -50,12 +50,31 @@ then
 # Extra configuration for Instana tracing
 load_module modules/ngx_http_opentracing_module.so;
 
-# Pass through these env vars
-env INSTANA_SERVICE_NAME;
-env INSTANA_AGENT_HOST;
-env INSTANA_AGENT_PORT;
-env INSTANA_MAX_BUFFERED_SPANS;
-env INSTANA_DEV;
+# Performance tuning for high throughput
+worker_rlimit_nofile 8192;
+events {
+    worker_connections 2048;
+    multi_accept on;
+}
+
+http {
+    # Optimize header handling
+    client_header_buffer_size 16k;
+    large_client_header_buffers 4 32k;
+    
+    # Connection keepalive
+    keepalive_timeout 65;
+    keepalive_requests 1000;
+
+    # Pass through these env vars
+    env INSTANA_SERVICE_NAME;
+    env INSTANA_AGENT_HOST;
+    env INSTANA_AGENT_PORT;
+    env INSTANA_MAX_BUFFERED_SPANS;
+    env INSTANA_DEV;
+    
+    include /etc/nginx/conf.d/*.conf;
+}
 !EOF!
 
     mv /tmp/nginx.conf /etc/nginx/nginx.conf
@@ -64,6 +83,29 @@ else
     echo "Tracing not enabled"
     # remove tracing config
     sed -i '1,3d' /etc/nginx/conf.d/default.conf
+    # Apply performance enhancements
+    cat - /etc/nginx/nginx.conf << !EOF! > /tmp/nginx.conf
+events {
+    worker_connections 2048;
+    multi_accept on;
+}
+
+http {
+    client_header_buffer_size 16k;
+    large_client_header_buffers 4 32k;
+    keepalive_timeout 65;
+    keepalive_requests 1000;
+    
+    # File cache for static content
+    open_file_cache max=1000 inactive=30s;
+    open_file_cache_valid 60s;
+    open_file_cache_min_uses 2;
+    open_file_cache_errors on;
+    
+    include /etc/nginx/conf.d/*.conf;
+}
+!EOF!
+    mv /tmp/nginx.conf /etc/nginx/nginx.conf
 fi
 
 exec nginx-debug -g "daemon off;"
-- 
2.51.0

